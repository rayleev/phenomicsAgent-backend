# ── 环境变量示例 ─────────────────────────────────────────
# 复制为 .env 并填入真实值。.env 已被 gitignore，不会入库。
# 启动后端前必须设置以下两个变量，否则服务拒绝启动。

# JWT 签名密钥（HS256）。生产环境用强随机值，例如：
#   export JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# API Key 加密密钥（用于加密用户保存的 LLM API Key）。
# 生产环境用强随机值，例如：
#   export ENCRYPTION_KEY=$(openssl rand -base64 32)
ENCRYPTION_KEY=replace-with-another-long-random-string

# ── 可选 ────────────────────────────────────────────────
# 无人机影像服务地址（默认 http://localhost:8002）
# DRONE_IMAGING_BASE=http://localhost:8002
